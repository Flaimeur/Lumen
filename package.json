{
  "name": "lumen-frontend",
  "productName": "Lumen",
  "version": "0.29.1",
  "description": "Frontend d'émulation pour PC, pensé pour la manette.",
  "author": "Lumen",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "windowed": "electron . --windowed",
    "preview": "node scripts/preview-server.js",
    "check": "node scripts/check.js",
    "check:thumbnails": "node scripts/check-thumbnails.js",
    "check:romm": "node scripts/check-romm.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:mac:local": "electron-builder --mac dir"
  },
  "build": {
    "appId": "app.lumen.frontend",
    "productName": "Lumen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Flaimeur",
        "repo": "Lumen",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Lumen pilote Spotify / Musique (widget Lecture en cours) et la mise en veille ou l'extinction du Mac.",
        "NSBluetoothAlwaysUsageDescription": "Lumen lit les manettes Bluetooth.",
        "LSApplicationCategoryType": "public.app-category.games"
      },
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac.${ext}",
      "title": "Lumen ${version}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
